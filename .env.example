# ── App Configuration ──
APP_NAME="Backend Automation Platform"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8001

# ── Database (MySQL) ──
POSTGRES_URL="mysql+aiomysql://user:password@db:3306/db_name"
POSTGRES_ECHO=false

# ── MongoDB ──
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=backend_platform

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── AI Settings ──
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
# GROK_API_KEY=your-grok-key
# OPENAI_API_KEY=your-openai-key

# ── Authentication ──
JWT_SECRET_KEY=generate-a-strong-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
