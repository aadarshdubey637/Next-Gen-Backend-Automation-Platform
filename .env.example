# ========================================
# Next-Gen Backend Automation Platform
# Environment Configuration
# ========================================

# Application
APP_NAME="Backend Automation Platform"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (Using SQLite for local dev)
POSTGRES_URL="sqlite+aiosqlite:///./backend.db"
POSTGRES_ECHO=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=backend_platform

# Redis
REDIS_URL=redis://localhost:6379/0

GEMINI_API_KEY=AIzaSyAFBKMGO2dIFJyarajQtEhKltXPg5BCFRc
AI_PROVIDER=gemini
# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
